        },
        {
          "name": "Get Doctor Reviews",
          "request": { "method": "GET", "url": "{{baseUrl}}/doctors/{{doctorId}}/reviews" }
        },
        {
          "name": "Open Doctor Queue Session",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
