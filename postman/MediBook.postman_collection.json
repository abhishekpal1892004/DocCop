    {
      "name": "Phase 11 - ABDM, ABHA, HPR/HFR, FHIR R4, HIP & HIU",
      "item": [
        {
          "name": "Get ABHA Linking Status",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/abdm/abha/status"
          }
        },
        {
          "name": "Convert Prescription to FHIR R4 Bundle",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/interoperability/fhir/convert",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recordSourceType\": \"PRESCRIPTION\",\n  \"recordId\": \"{{prescriptionId}}\"\n}"
            }
          }
        },
        {
          "name": "Initiate HIU Consent Request",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/abdm/hiu/consent-request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"Care management\",\n  \"recordTypes\": [\"Prescription\", \"DiagnosticReport\"],\n  \"dateRange\": {\n    \"from\": \"2026-01-01T00:00:00.000Z\",\n    \"to\": \"2026-11-01T00:00:00.000Z\"\n  },\n  \"expiresAt\": \"2027-01-01T00:00:00.000Z\"\n}"
            }
          }
        },
        {
          "name": "Get Admin ABDM Integration Dashboard",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/abdm/admin/dashboard"
          }
        }
      ]
    }
  ]
