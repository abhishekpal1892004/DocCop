NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/medibook

# Clerk (Dashboard -> API keys). The secret key must NEVER be exposed to the frontend.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Dashboard -> Webhooks -> endpoint -> Signing Secret (whsec_...)
CLERK_WEBHOOK_SIGNING_SECRET=

# Comma-separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:5173

# --- Frontend (.env of the React/Vite app, not this backend) ---
# VITE_CLERK_PUBLISHABLE_KEY=
# VITE_API_BASE_URL=http://localhost:5000

# Calendly OAuth 2.1 + PKCE & Webhooks (Phase 5)
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=http://localhost:5000/api/v1/integrations/calendly/callback
CALENDLY_WEBHOOK_SIGNING_KEY=
# 64 hex chars (32 bytes) or passphrase used to derive AES-256-GCM key for token encryption
CALENDLY_TOKEN_ENCRYPTION_KEY=

# Twilio Programmable SMS & WhatsApp (Phase 6)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

TWILIO_CONTENT_SID_APPOINTMENT_CONFIRMED=
TWILIO_CONTENT_SID_APPOINTMENT_REMINDER=
TWILIO_CONTENT_SID_APPOINTMENT_CANCELLED=
TWILIO_CONTENT_SID_APPOINTMENT_RESCHEDULED=

TWILIO_STATUS_CALLBACK_URL=http://localhost:5000/api/v1/webhooks/twilio/status
TWILIO_WHATSAPP_SANDBOX_ENABLED=true

# Optional India DLT configuration for domestic transactional SMS
TWILIO_DLT_ENTITY_ID=
TWILIO_DLT_SENDER_ID=

# MongoDB-backed Notification Scheduler
NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_SECONDS=60
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_SECONDS=60

# Medical Document Encryption (Phase 7 - AES-256-GCM key versioning)
MEDICAL_DOC_ENCRYPTION_ACTIVE_VERSION=v1
MEDICAL_DOC_ENCRYPTION_KEY_V1=
CLAMAV_SCAN_ENABLED=false

# Razorpay Payments (Phase 8A)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CALLBACK_URL=
RAZORPAY_PAYMENT_CURRENCY=INR
RAZORPAY_PAYMENT_TIMEOUT_MINUTES=10

# Agora Video Consultations (Phase 8B)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRY_SECONDS=3600
AGORA_ENABLED=true

# Phase 8 Feature Flags
PAYMENT_ENABLED=true
VIDEO_CONSULTATION_ENABLED=true
QUEUE_MANAGEMENT_ENABLED=true
REVIEWS_ENABLED=true

# Phase 11 - ABDM Sandbox & Interoperability (disabled by default until NHA sandbox approval)
ABDM_ENABLED=false
ABDM_ENVIRONMENT=SANDBOX
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_ABHA_BASE_URL=https://abhasbx.abdm.gov.in
ABDM_CM_ID=sbx
ABDM_CALLBACK_BASE_URL=
ABDM_FACILITY_ID=
ABDM_INTEGRATION_ROLE=
ABDM_ENCRYPTION_KEY=
ABDM_WEBHOOK_SECRET=
ABDM_REQUEST_TIMEOUT_MS=15000
